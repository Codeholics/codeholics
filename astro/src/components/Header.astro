---
const siteTitle = Astro.props.title ?? 'Codeholics';
---
<header class="bg-white shadow-sm">
  <div class="max-w-4xl mx-auto px-4 py-6 flex items-center justify-between">
    <a class="text-2xl font-semibold text-slate-900" href="/">{siteTitle}</a>
    <nav class="space-x-4 text-slate-600">
      <a class="hover:text-slate-900" href="/">Home</a>
      <a class="hover:text-slate-900" href="/about">About</a>
      <a class="hover:text-slate-900" href="/tags">Tags</a>
      <a class="hover:text-slate-900" href="/categories">Categories</a>
    </nav>
  </div>
</header>
