---
const siteTitle = Astro.props.title ?? 'Codeholics';
---
<header class="w-full bg-gradient-to-b from-slate-900/60 to-transparent backdrop-blur-sm border-b border-white/5">
  <div class="max-w-7xl mx-auto px-6 py-4 grid grid-cols-3 items-center gap-4">
    <!-- Brand (left) -->
    <div class="flex items-center">
      <a href="/" class="inline-flex items-center gap-3">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 rounded-full p-1 shadow" aria-hidden>
          <defs>
            <linearGradient id="g1" x1="0" x2="1" y1="0" y2="1">
              <stop offset="0" stop-color="#7c3aed" />
              <stop offset="1" stop-color="#5b21b6" />
            </linearGradient>
          </defs>
          <circle cx="12" cy="12" r="10" fill="url(#g1)" />
          <path d="M8 12h8" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="text-lg font-semibold tracking-tight text-white">{siteTitle}</span>
      </a>
    </div>

    <!-- Centered nav (center) -->
    <nav aria-label="Primary" class="flex justify-center">
      <ul class="inline-flex items-center space-x-2 md:space-x-4 bg-white/2 rounded-md px-2 py-1">
        <li><a class="px-3 py-2 rounded-md text-sm font-medium text-slate-200 hover:text-white hover:bg-white/5 focus:outline-none focus:ring-2 focus:ring-white/10 transition" href="/">Home</a></li>
        <li><a class="px-3 py-2 rounded-md text-sm font-medium text-slate-200 hover:text-white hover:bg-white/5 focus:outline-none focus:ring-2 focus:ring-white/10 transition" href="/about">About</a></li>
        <li><a class="px-3 py-2 rounded-md text-sm font-medium text-slate-200 hover:text-white hover:bg-white/5 focus:outline-none focus:ring-2 focus:ring-white/10 transition" href="/posts">Posts</a></li>
        <li><a class="px-3 py-2 rounded-md text-sm font-medium text-slate-200 hover:text-white hover:bg-white/5 focus:outline-none focus:ring-2 focus:ring-white/10 transition" href="/tags">Tags</a></li>
        <li><a class="px-3 py-2 rounded-md text-sm font-medium text-slate-200 hover:text-white hover:bg-white/5 focus:outline-none focus:ring-2 focus:ring-white/10 transition" href="/categories">Categories</a></li>
      </ul>
    </nav>

    <!-- Utilities (right) -->
    <div class="flex items-center justify-end gap-3">
      <form action="/search" method="get" class="hidden sm:flex items-center bg-white/5 backdrop-blur rounded-full px-2 py-1">
        <input name="q" class="bg-transparent placeholder:text-slate-300 text-sm text-white outline-none px-2" placeholder="Search" />
        <button class="text-slate-300 px-2" aria-label="Search">🔍</button>
      </form>

      <button id="nav-toggle" class="md:hidden p-2 rounded-md text-slate-200 hover:bg-white/5" aria-label="Open menu" aria-expanded="false">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile panel -->
  <div id="nav-panel" class="md:hidden hidden px-4 pb-4">
    <div class="space-y-2">
      <a class="block py-2 px-3 rounded hover:bg-white/5 text-slate-200" href="/">Home</a>
      <a class="block py-2 px-3 rounded hover:bg-white/5 text-slate-200" href="/about">About</a>
      <a class="block py-2 px-3 rounded hover:bg-white/5 text-slate-200" href="/posts">Posts</a>
      <a class="block py-2 px-3 rounded hover:bg-white/5 text-slate-200" href="/tags">Tags</a>
      <a class="block py-2 px-3 rounded hover:bg-white/5 text-slate-200" href="/categories">Categories</a>

      <form action="/search" method="get" class="mt-2">
        <label class="sr-only">Search</label>
        <div class="flex items-center gap-2">
          <input name="q" class="w-full rounded-md px-3 py-2 bg-white/5 placeholder:text-slate-300 text-white outline-none" placeholder="Search" />
          <button class="px-3 py-2 rounded-md bg-white/5 text-slate-200">Search</button>
        </div>
      </form>
    </div>
  </div>

  <script type="module">
    const btn = document.getElementById('nav-toggle');
    const panel = document.getElementById('nav-panel');
    btn?.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      panel?.classList.toggle('hidden');
    });
  </script>
</header>
