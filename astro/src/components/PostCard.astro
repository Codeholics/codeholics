---
const { post } = Astro.props;
---
<article style="margin-bottom:1.25rem;padding:0.75rem;border:1px solid #e6e6e6;border-radius:6px">
  <h2 style="margin:0 0 0.25rem 0"><a href={`/posts/${post.slug}`} style="text-decoration:none;color:inherit">{post.frontmatter.title}</a></h2>
  <div style="color:#888;font-size:0.9rem;margin-bottom:0.5rem">{post.frontmatter.date}</div>
  {post.frontmatter.summary ? <p style="margin:0">{post.frontmatter.summary}</p> : null}
</article>
