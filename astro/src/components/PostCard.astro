---
const { post } = Astro.props;
---
<article class="post-card border rounded-lg p-6 bg-white shadow-sm hover:shadow-md transition-shadow">
  <h2 class="text-xl font-semibold"><a class="text-slate-900 hover:text-indigo-600" href={`/posts/${post.slug}`}>{post.frontmatter.title}</a></h2>
  <div class="post-meta text-sm text-slate-500 mt-1">{post.frontmatter.date}</div>
  {post.frontmatter.summary ? <p class="post-summary mt-3 text-slate-700">{post.frontmatter.summary}</p> : null}
</article>
