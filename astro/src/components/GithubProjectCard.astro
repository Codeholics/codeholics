---
interface Props {
  showStaticBadge?: boolean;
  project: {
    fullName: string;
    htmlUrl: string;
    description: string | null;
    stars: number;
    forks: number;
    language: string | null;
  };
}

const { project, showStaticBadge = true } = Astro.props;
const languageColors: Record<string, string> = {
  Astro: '#ff5d01',
  CSS: '#663399',
  HTML: '#e34c26',
  JavaScript: '#f1e05a',
  PowerShell: '#012456',
  Python: '#3572a5',
  Rust: '#dea584',
  TypeScript: '#3178c6',
};
const languageColor = project.language
  ? languageColors[project.language] ?? '#64748b'
  : '#64748b';
---

<article class="project-card group">
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <h3 class="project-card-title">
        <a
          class="project-card-link"
          href={project.htmlUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg aria-hidden="true" class="project-repository-icon" viewBox="0 0 16 16" fill="currentColor">
            <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 0 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5v-9Zm10.5-1V9h-8c-.356 0-.694.074-1 .208V2.5a1 1 0 0 1 1-1h8Z"></path>
          </svg>
          <span class="truncate">{project.fullName}</span>
        </a>
      </h3>
    </div>
    {showStaticBadge && <span class="project-static-badge">Static</span>}
  </div>

  <p class="project-description">
    {project.description || 'No description provided for this software repository.'}
  </p>

  <div class="project-metadata">
    <div class="flex items-center gap-4">
      <span class="project-metric" aria-label={`${project.stars.toLocaleString()} stars`}>
        <svg aria-hidden="true" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"></path>
        </svg>
        {project.stars.toLocaleString()}
      </span>
      <span class="project-metric" aria-label={`${project.forks.toLocaleString()} forks`}>
        <svg aria-hidden="true" viewBox="0 0 16 16" fill="currentColor">
          <path d="M5 3.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm0 2.122a2.25 2.25 0 1 0-1.5 0v4.256a2.251 2.251 0 1 0 1.5 0V5.372Zm8 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM11.5 7a2.25 2.25 0 1 0 0 4.5 2.25 2.25 0 0 0 0-4.5ZM7.75 5.25a.75.75 0 0 1 .75.75v2.25h1.75a.75.75 0 0 1 0 1.5H8.5V12a.75.75 0 0 1-1.5 0V9.75H5.25a.75.75 0 0 1 0-1.5H7V6a.75.75 0 0 1 .75-.75Z"></path>
        </svg>
        {project.forks.toLocaleString()}
      </span>
    </div>
    {project.language && (
      <span class="project-language">
        <span class="project-language-dot" style={`--language-color: ${languageColor}`}></span>
        {project.language}
      </span>
    )}
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.625rem;
    overflow: hidden;
    border: 1px solid var(--surface-border);
    border-radius: 0.375rem;
    background: transparent;
    padding: 0.75rem;
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  .project-card:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--page-heading) 5%, transparent);
  }

  .project-card-title {
    color: var(--page-heading);
    font-size: 0.875rem;
    font-weight: 650;
    line-height: 1.35;
  }

  .project-card-link {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 0.4rem;
    border-radius: 0.2rem;
    text-decoration: none;
  }

  .project-card-link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .project-card-link:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  .project-repository-icon {
    width: 0.875rem;
    height: 0.875rem;
    flex: none;
    color: var(--muted-soft);
  }

  .project-static-badge {
    flex: none;
    border: 1px solid var(--surface-border);
    border-radius: 9999px;
    background: transparent;
    padding: 0.1rem 0.4rem;
    color: var(--muted);
    font-family: ui-monospace, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.025em;
  }

  .project-description {
    display: -webkit-box;
    min-height: 0;
    overflow: hidden;
    color: var(--muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .project-metadata {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.625rem;
    color: var(--muted-soft);
    font-size: 0.6875rem;
    font-weight: 500;
  }

  .project-metadata > div {
    gap: 0.625rem;
  }

  .project-metric svg {
    width: 0.75rem;
    height: 0.75rem;
  }

  .project-metric,
  .project-language {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
  }

  .project-metric:first-child svg {
    color: #b7791f;
  }

  .project-language-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 9999px;
    background-color: var(--language-color);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none;
    }
  }
</style>
