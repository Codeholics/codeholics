---
import HeaderAppbar from '../components/Header.appbar.astro';
import Footer from '../components/Footer.astro';
import { publicAssetUrl } from '../lib/asset-url';
import '../styles/global.css';

const faviconSvgUrl = publicAssetUrl('/favicon/favicon.svg');
const faviconIcoUrl = publicAssetUrl('/favicon/favicon.ico');

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const defaultImage = '/assets/og-default.png';
const {
  title = 'Codeholics',
  description = 'Notes, tutorials, and reviews about software, hardware, and systems - written with clarity and practical examples.',
  ogImage,
  ogType = 'website',
} = Astro.props;

if (!Astro.site) {
  throw new Error('Social metadata requires the canonical site URL in Astro configuration.');
}

const url = new URL(Astro.url.pathname, Astro.site).href;
const imagePath = ogImage?.trim().replace(/\\/g, '/') || defaultImage;
const imageUrl = new URL(imagePath, Astro.site).href;
const isDefaultImage = imageUrl === new URL(defaultImage, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    {isDefaultImage && (
      <>
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="Codeholics" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- Facebook App ID -->
    <meta property="fb:app_id" content="966242223397117" />

    <!-- Favicons -->
    <link rel="apple-touch-icon" sizes="180x180" href={publicAssetUrl('/favicon/apple-touch-icon.png')} />
    <link rel="icon" type="image/svg+xml" href={faviconSvgUrl} />
    <link rel="icon" type="image/png" sizes="32x32" href={publicAssetUrl('/favicon/favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={publicAssetUrl('/favicon/favicon-16x16.png')} />
    <link rel="icon" type="image/x-icon" href={faviconIcoUrl} />

    <!-- Site Manifest for Mobile add home features and such -->
    <link rel="manifest" href={publicAssetUrl('/site.webmanifest')} />

    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <script>
      (function(){
        var root = document.documentElement;
        var resolveTheme = function(mode) {
          if (mode === 'dark' || mode === 'light') return mode;
          return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        };
        var applyTheme = function(mode) {
          var resolved = resolveTheme(mode);
          root.dataset.themeMode = mode;
          root.dataset.theme = resolved;
          root.classList.toggle('dark', resolved === 'dark');
        };

        var mode = 'auto';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark' || stored === 'auto') {
            mode = stored;
          }
        } catch (e) {}

        applyTheme(mode);
      })();
    </script>
  </head>
  <body class="min-h-screen font-inter">
    <HeaderAppbar />
    <main class="max-w-4xl mx-auto px-4 py-8">
      <slot />
    </main>
    <Footer />
    <script>
      (function () {
        function copyText(text) {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            return navigator.clipboard.writeText(text);
          }

          return new Promise(function (resolve, reject) {
            var textArea = document.createElement('textarea');
            textArea.value = text;
            textArea.setAttribute('readonly', 'readonly');
            textArea.style.position = 'absolute';
            textArea.style.left = '-9999px';
            document.body.appendChild(textArea);
            textArea.select();

            try {
              document.execCommand('copy');
              resolve();
            } catch (error) {
              reject(error);
            } finally {
              document.body.removeChild(textArea);
            }
          });
        }

        function attachCopyButtons() {
          var blocks = document.querySelectorAll('figure[data-rehype-pretty-code-figure] pre');

          blocks.forEach(function (pre) {
            if (pre.querySelector('.code-copy-button')) {
              return;
            }

            var button = document.createElement('button');
            button.type = 'button';
            button.className = 'code-copy-button';
            button.textContent = 'Copy';
            button.setAttribute('aria-label', 'Copy code to clipboard');

            button.addEventListener('click', function () {
              var code = pre.querySelector('code');
              var text = code ? code.innerText : pre.innerText;
              copyText(text.trimEnd())
                .then(function () {
                  button.textContent = 'Copied';
                  setTimeout(function () {
                    button.textContent = 'Copy';
                  }, 1600);
                })
                .catch(function () {
                  button.textContent = 'Failed';
                  setTimeout(function () {
                    button.textContent = 'Copy';
                  }, 1600);
                });
            });

            pre.appendChild(button);
          });
        }

        function normalizeInlineCodeDelimiters() {
          var inlineCodeSpans = document.querySelectorAll(
            '.theme-prose span[data-rehype-pretty-code-figure]',
          );
          var normalizedCount = 0;

          inlineCodeSpans.forEach(function (span) {
            var sibling = span.nextSibling;
            if (!sibling || sibling.nodeType !== Node.TEXT_NODE) {
              return;
            }

            var text = sibling.textContent || '';
            var normalized = text.replace(
              /^(\\s+[A-Za-z0-9_./-]+)`(?=($|[\\s.,;:!?)]))/,
              '$1',
            );

            if (normalized === text) {
              return;
            }

            sibling.textContent = normalized;
            normalizedCount += 1;
          });

          if (normalizedCount > 0) {
            console.warn(
              '[inline-code] Applied ' +
              normalizedCount +
              ' deterministic inline-code normalization fix(es) in rendered content.',
            );
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function () {
            normalizeInlineCodeDelimiters();
            attachCopyButtons();
          }, { once: true });
        } else {
          normalizeInlineCodeDelimiters();
          attachCopyButtons();
        }
      })();
    </script>
  </body>
</html>
