---
import HeaderAppbar from '../components/Header.appbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <script>
      (function(){
        try {
          var p = localStorage.getItem('theme');
          if(p === 'dark' || (!p && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
          }
        } catch(e){}
      })();
    </script>
    <title>Codeholics</title>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 font-inter">
    <HeaderAppbar />
    <main class="max-w-4xl mx-auto px-4 py-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
