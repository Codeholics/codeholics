---
import CuratedProjects from '../../components/CuratedProjects.astro';
import GithubProjects from '../../components/GithubProjects.astro';
import Layout from '../../layouts/Layout.astro';
import { publicAssetUrl } from '../../lib/asset-url';
import { loadCuratedRepositories } from '../../lib/github-projects.mjs';

const curatedCategories = await loadCuratedRepositories({
  token: import.meta.env.GITHUB_TOKEN,
});
const heroImageUrl = publicAssetUrl(
  '/images/projects/cyberpunk_developer_desk_under_moonlight_fullsize.webp',
);
---

<Layout
  title="Featured Projects | Codeholics"
  description="Open-source projects from Codeholics and curated GitHub repositories worth exploring."
  wide
  flushTop
>
  <div class="featured-projects-page">
    <header class="projects-hero">
      <div class="projects-hero-art" aria-hidden="true">
        <img
          src={heroImageUrl}
          alt=""
          width="1983"
          height="793"
          fetchpriority="high"
        />
      </div>
      <div class="projects-hero-copy">
        <p class="projects-eyebrow">&gt;_ Codeholics Projects</p>
        <h1 class="projects-title">Featured Projects</h1>
        <p class="projects-summary">
          Open-source projects I build and useful repositories I recommend.
          Explore my work or browse recommendations by category.
        </p>
      </div>
    </header>

    <GithubProjects />
    <CuratedProjects categories={curatedCategories} />
  </div>
</Layout>

<style>
  .featured-projects-page {
    container-type: inline-size;
  }

  .projects-hero {
    position: relative;
    display: grid;
    min-height: max(17rem, 23.2cqw);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--surface-border);
    background: transparent;
  }

  /*
   * The mask fades the artwork into whatever page background is underneath, so the blend follows the
   * theme and the body gradient without a seam. It is fully transparent across the copy column's overlap.
   */
  .projects-hero-art {
    position: absolute;
    z-index: 0;
    inset: 0 0 0 auto;
    width: 58%;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, transparent 16%, rgb(0 0 0 / 0.3) 30%, rgb(0 0 0 / 0.8) 62%, #000 100%);
    mask-image: linear-gradient(90deg, transparent 0%, transparent 16%, rgb(0 0 0 / 0.3) 30%, rgb(0 0 0 / 0.8) 62%, #000 100%);
  }

  .projects-hero-art::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      0deg,
      color-mix(in srgb, var(--bg) 30%, transparent),
      transparent 38%,
      color-mix(in srgb, var(--bg) 16%, transparent)
    );
    content: '';
  }

  .projects-hero-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% center;
  }

  .projects-hero-copy {
    position: relative;
    z-index: 1;
    grid-column: 1;
    max-width: 34rem;
    padding: 1.5rem 1rem 1.5rem 0;
  }

  .projects-eyebrow {
    color: var(--accent);
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .projects-title {
    margin-top: 0.55rem;
    color: var(--page-heading);
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .projects-summary {
    max-width: 44rem;
    margin-top: 1rem;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  /* Narrow screens stack the art above the copy so every wrapped line sits on the page background. */
  @media (max-width: 640px) {
    .projects-hero {
      min-height: 0;
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }

    .projects-hero-art {
      position: relative;
      inset: auto;
      width: 100%;
      height: clamp(11rem, 56cqw, 14rem);
      -webkit-mask-image: linear-gradient(0deg, transparent 0%, rgb(0 0 0 / 0.35) 22%, rgb(0 0 0 / 0.88) 60%, #000 100%);
      mask-image: linear-gradient(0deg, transparent 0%, rgb(0 0 0 / 0.35) 22%, rgb(0 0 0 / 0.88) 60%, #000 100%);
    }

    .projects-hero-art img {
      object-position: 57% center;
    }

    .projects-hero-copy {
      grid-column: 1;
      max-width: 100%;
      padding: 0.5rem 0.5rem 1.5rem;
    }
  }
</style>
