---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const modules = import.meta.glob('../../content/posts/*.md', { eager: true });
  return Object.keys(modules).map((p) => {
    const slug = p.split('/').pop().replace('.md', '');
    return { params: { slug } };
  });
}

const { slug } = Astro.params;
const modules = import.meta.glob('../../content/posts/*.md', { eager: true });

let matchedKey = Object.keys(modules).find((p) => p.endsWith(`${slug}.md`));
if (!matchedKey) {
  throw new Error('Post not found');
}
const mod = modules[matchedKey];
const Content = mod.default;
const { frontmatter } = mod;
---

<Layout>
  <article>
    <h1>{frontmatter.title}</h1>
    <div style="color:#666">{frontmatter.date}</div>
    <hr />
    <Content />
  </article>
</Layout>
