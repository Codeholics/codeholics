---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const modules = import.meta.glob('../../content/posts/*.md', { eager: true });
  return Object.keys(modules).map((p) => {
    const slug = p.split('/').pop().replace('.md', '');
    return { params: { slug } };
  });
}

const { slug } = Astro.params;
const modules = import.meta.glob('../../content/posts/*.md', { eager: true });

let matchedKey = Object.keys(modules).find((p) => p.endsWith(`${slug}.md`));
if (!matchedKey) {
  throw new Error('Post not found');
}
const mod = modules[matchedKey];
const Content = mod.default;
const { frontmatter } = mod;
---

<Layout>
  <article class="max-w-3xl mx-auto bg-white p-8 rounded-lg shadow-sm">
    <h1 class="text-3xl font-bold text-slate-900">{frontmatter.title}</h1>
    <div class="text-sm text-slate-500 mt-2">{frontmatter.date}</div>
    <hr class="my-6" />
    <div class="prose prose-slate max-w-none"><Content /></div>
  </article>
</Layout>
