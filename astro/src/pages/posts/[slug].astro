---
import Layout from '../../layouts/Layout.astro';
import { getPostBySlug, loadPosts } from '../../lib/posts';

export async function getStaticPaths() {
  return loadPosts().map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const post = slug ? getPostBySlug(slug) : undefined;
if (!post) {
  throw new Error('Post not found');
}
const { Content, frontmatter } = post;
---

<Layout>
  <article class="theme-reading-surface max-w-3xl mx-auto rounded-lg p-8">
    <h1 class="theme-page-title text-3xl font-bold">{frontmatter.title}</h1>
    <div class="theme-meta text-sm mt-2">{frontmatter.date}</div>
    <hr class="theme-divider my-6" />
    <div class="theme-prose prose prose-slate max-w-none"><Content /></div>
  </article>
</Layout>
