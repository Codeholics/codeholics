---
import Layout from '../layouts/Layout.astro';

// Load all markdown posts from src/content/posts
const modules = import.meta.glob('../content/posts/*.md', { eager: true });

const posts = Object.entries(modules).map(([path, mod]) => {
  const fileName = path.split('/').pop();
  const slug = fileName.replace('.md', '');
  return { slug, frontmatter: mod.frontmatter };
}).sort((a, b) => new Date(b.frontmatter.date) - new Date(a.frontmatter.date));
---

<Layout>
  <main class="container">
    <h1>Codeholics</h1>
    <section>
      {posts.length ? (
        <ul>
          {posts.map((post) => (
            <li>
              <a href={`/posts/${post.slug}`}><strong>{post.frontmatter.title}</strong></a>
              <div><small>{post.frontmatter.date}</small></div>
              {post.frontmatter.summary ? <p>{post.frontmatter.summary}</p> : null}
            </li>
          ))}
        </ul>
      ) : (
        <p>No posts yet.</p>
      )}
    </section>
  </main>
</Layout>
