---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { loadPosts, paginate, PAGE_SIZE } from '../lib/posts';

const posts = loadPosts();
const { items, current, totalPages } = paginate(posts, 1, PAGE_SIZE);
---

<Layout>
  <header class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900">Codeholics</h1>
    <p class="text-slate-600 mt-2">Tech notes, tutorials, and reviews.</p>
  </header>

  <section class="grid gap-6 md:grid-cols-2">
    {items.length ? (
      items.map((post) => (
        <PostCard post={post} />
      ))
    ) : (
      <p class="text-slate-700">No posts yet.</p>
    )}
  </section>

  <nav class="flex items-center justify-between mt-8 text-sm text-slate-600">
    {current>1 ? <a class="text-indigo-600 hover:underline" href={current===2?'/':'/page/1'}>← Newer</a> : <span />}
    {current<totalPages ? <a class="text-indigo-600 hover:underline" href={`/page/${current+1}`}>Older →</a> : <span />}
  </nav>
</Layout>
