---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { loadPosts, getAllTags, PAGE_SIZE, paginate } from '../lib/posts';

const posts = await loadPosts();
const featured = posts.slice(0, 4);
const { items, current, totalPages } = paginate(posts, 1, PAGE_SIZE);
const tags = getAllTags(posts).slice(0, 24);
const categories = (() => {
  const map = new Map();
  for (const p of posts) {
    const c = (p.frontmatter.category || '').toString().trim();
    if (!c) continue;
    map.set(c, (map.get(c) || 0) + 1);
  }
  return Array.from(map.entries()).map(([name, count]) => ({ name, count }));
})();
---

<Layout>
  <!-- Hero (Bootstrap-like, modern colors) -->
  <section class="theme-home-hero rounded-xl p-8 mb-8">
    <div class="max-w-4xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div>
          <h1 class="theme-home-hero-title text-4xl font-extrabold">Codeholics</h1>
          <p class="theme-home-hero-copy mt-3 max-w-xl">Notes, tutorials, and reviews about software, hardware, and systems — written with clarity and practical examples.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a class="theme-primary-action inline-block px-4 py-2 rounded-md hover:shadow-md" href="/posts">View posts</a>
            <a class="theme-home-secondary-action inline-block px-4 py-2 rounded-md" href="/tags">Explore tags</a>
          </div>
        </div>
        <div class="hidden md:block w-48">
          <!-- small illustrative card to echo Bootstrap theme visual -->
          <div class="theme-home-panel p-4 rounded-md">
            <h3 class="theme-home-panel-heading text-lg font-semibold">Sleek & modern</h3>
            <p class="theme-home-hero-copy text-sm mt-2">Readable posts, elegant layout, Tailwind-powered utilities.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main content: two-column layout -->
  <div class="grid gap-8 lg:grid-cols-3">
    <main class="lg:col-span-2 space-y-6">
      <h2 class="theme-section-heading text-2xl font-semibold">Latest posts</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {featured.map(p => (
          <PostCard post={p} />
        ))}
      </div>

      <section class="mt-4">
        <h3 class="theme-section-subheading text-lg font-medium mb-3">All posts</h3>
        <div class="space-y-4">
          {items.map(post => (
            <PostCard post={post} />
          ))}
        </div>

        <nav class="theme-page-copy flex items-center justify-between mt-6 text-sm">
          {current>1 ? <a class="theme-link hover:underline" href={current===2?'/':'/page/1'}>← Newer</a> : <span />}
          {current<totalPages ? <a class="theme-link hover:underline" href={`/page/${current+1}`}>Older →</a> : <span />}
        </nav>
      </section>
    </main>

    <aside class="lg:col-span-1 space-y-6">
      <div class="theme-home-panel p-4 rounded-md">
        <h4 class="theme-home-panel-heading font-semibold">Tags</h4>
        <div class="mt-3 flex flex-wrap gap-2">
          {tags.map(t => (
            <a class="theme-home-chip text-sm px-3 py-1 rounded-full" href={`/tags/${encodeURIComponent(t.tag)}`}>{t.tag} <span class="theme-home-chip-count ml-1 text-xs">{t.count}</span></a>
          ))}
        </div>
      </div>

      <div class="theme-home-panel p-4 rounded-md">
        <h4 class="theme-home-panel-heading font-semibold">Categories</h4>
        <ul class="mt-3 space-y-2">
          {categories.map(c => (
            <li><a class="theme-home-link text-sm hover:underline" href={`/categories/${encodeURIComponent(c.name)}`}>{c.name} <span class="theme-home-chip-count text-xs">({c.count})</span></a></li>
          ))}
        </ul>
      </div>

    </aside>
  </div>
</Layout>
