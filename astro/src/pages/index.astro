---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { loadPosts, getAllTags, PAGE_SIZE, paginate } from '../lib/posts';

const posts = loadPosts();
const featured = posts.slice(0, 4);
const { items, current, totalPages } = paginate(posts, 1, PAGE_SIZE);
const tags = getAllTags(posts).slice(0, 24);
const categories = (() => {
  const map = new Map();
  for (const p of posts) {
    const c = (p.frontmatter.category || '').toString().trim();
    if (!c) continue;
    map.set(c, (map.get(c) || 0) + 1);
  }
  return Array.from(map.entries()).map(([name, count]) => ({ name, count }));
})();
---

<Layout>
  <!-- Hero (Bootstrap-like, modern colors) -->
  <section class="rounded-xl bg-gradient-to-r from-[rgba(124,58,237,0.12)] via-[rgba(124,58,237,0.08)] to-transparent p-8 mb-8">
    <div class="max-w-4xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div>
          <h1 class="text-4xl font-extrabold text-white">Codeholics</h1>
          <p class="mt-3 text-slate-300 max-w-xl">Notes, tutorials, and reviews about software, hardware, and systems — written with clarity and practical examples.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a class="inline-block px-4 py-2 bg-white text-slate-900 rounded-md shadow-sm hover:shadow-md" href="/posts">View posts</a>
            <a class="inline-block px-4 py-2 border border-white/20 text-white rounded-md hover:bg-white/5" href="/tags">Explore tags</a>
          </div>
        </div>
        <div class="hidden md:block w-48">
          <!-- small illustrative card to echo Bootstrap theme visual -->
          <div class="bg-white/5 p-4 rounded-md">
            <h3 class="text-lg font-semibold text-white">Sleek & modern</h3>
            <p class="text-sm text-slate-300 mt-2">Readable posts, elegant layout, Tailwind-powered utilities.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main content: two-column layout -->
  <div class="grid gap-8 lg:grid-cols-3">
    <main class="lg:col-span-2 space-y-6">
      <h2 class="text-2xl font-semibold text-slate-100">Latest posts</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {featured.map(p => (
          <PostCard post={p} />
        ))}
      </div>

      <section class="mt-4">
        <h3 class="text-lg font-medium text-slate-200 mb-3">All posts</h3>
        <div class="space-y-4">
          {items.map(post => (
            <PostCard post={post} />
          ))}
        </div>

        <nav class="flex items-center justify-between mt-6 text-sm text-slate-400">
          {current>1 ? <a class="text-indigo-400 hover:underline" href={current===2?'/':'/page/1'}>← Newer</a> : <span />}
          {current<totalPages ? <a class="text-indigo-400 hover:underline" href={`/page/${current+1}`}>Older →</a> : <span />}
        </nav>
      </section>
    </main>

    <aside class="lg:col-span-1 space-y-6">
      <div class="bg-white/5 p-4 rounded-md">
        <h4 class="font-semibold text-white">Tags</h4>
        <div class="mt-3 flex flex-wrap gap-2">
          {tags.map(t => (
            <a class="text-sm px-3 py-1 rounded-full bg-white/10 text-slate-100 hover:bg-white/20" href={`/tags/${encodeURIComponent(t.tag)}`}>{t.tag} <span class="ml-1 text-xs text-slate-400">{t.count}</span></a>
          ))}
        </div>
      </div>

      <div class="bg-white/5 p-4 rounded-md">
        <h4 class="font-semibold text-white">Categories</h4>
        <ul class="mt-3 space-y-2">
          {categories.map(c => (
            <li><a class="text-sm text-slate-100 hover:underline" href={`/categories/${encodeURIComponent(c.name)}`}>{c.name} <span class="text-xs text-slate-400">({c.count})</span></a></li>
          ))}
        </ul>
      </div>

    </aside>
  </div>
</Layout>
