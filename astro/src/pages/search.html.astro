---
import Layout from '../layouts/Layout.astro';
import { loadPosts } from '../lib/posts';

const rawModules = import.meta.glob('../content/posts/*.md', {
  eager: true,
  query: '?raw',
  import: 'default',
}) as Record<string, string>;

const stripMarkdown = (raw = '') =>
  raw
    .replace(/^---[\s\S]*?---/, ' ')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/`[^`]*`/g, ' ')
    .replace(/!\[[^\]]*\]\([^)]+\)/g, ' ')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[#>*_~\-]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const normalize = (value = '') =>
  value
    .toString()
    .toLowerCase()
    .normalize('NFKD')
    .replace(/[\u0300-\u036f]/g, '');

const searchIndex = loadPosts().map((post) => {
  const rawPath = Object.keys(rawModules).find((path) => path.endsWith(`${post.slug}.md`));
  const rawContent = rawPath ? rawModules[rawPath] : '';
  const content = stripMarkdown(rawContent);
  const title = (post.frontmatter.title || post.slug).toString();
  const summary = (post.frontmatter.summary || '').toString();
  const category = (post.frontmatter.category || '').toString();
  const tags = (post.frontmatter.tags || '').toString();
  const excerpt = (summary || content).slice(0, 220).trim();

  return {
    slug: post.slug,
    title,
    summary,
    category,
    tags,
    date: (post.frontmatter.date || '').toString(),
    excerpt,
    searchText: normalize([title, summary, category, tags, content].join(' ')),
  };
});
---

<Layout>
  <section class="space-y-6">
    <header class="space-y-2">
      <h1 class="theme-page-title text-3xl font-bold">Search</h1>
      <p class="theme-page-copy">Search titles, summaries, categories, tags, and post content across the Astro site.</p>
    </header>

    <form action="/search.html" method="get" class="flex flex-col gap-3 md:flex-row md:items-center" role="search">
      <label class="sr-only" for="search-page-input">Search</label>
      <input
        id="search-page-input"
        name="q"
        class="theme-search-input w-full rounded-md px-4 py-3 outline-none md:flex-1"
        placeholder="Search posts"
        aria-label="Search"
        required
      />
      <button type="submit" class="rounded-md bg-indigo-500 px-4 py-3 font-medium text-white hover:bg-indigo-400">
        Search
      </button>
    </form>

    <p id="search-status" class="theme-page-copy text-sm"></p>

    <div id="search-results" class="space-y-4"></div>
  </section>

  <script define:vars={{ searchIndex }}>
    const input = document.getElementById('search-page-input');
    const status = document.getElementById('search-status');
    const results = document.getElementById('search-results');

    const renderResult = (post) => {
      const article = document.createElement('article');
      article.className = 'theme-surface rounded-lg p-6';

      const title = document.createElement('h2');
      title.className = 'theme-page-title text-xl font-semibold';

      const link = document.createElement('a');
      link.href = `/posts/${post.slug}`;
      link.className = 'hover:text-indigo-300';
      link.textContent = post.title;
      title.appendChild(link);

      const meta = document.createElement('p');
      meta.className = 'theme-page-copy mt-2 text-sm';
      meta.textContent = [post.date, post.category].filter(Boolean).join('  |  ');

      const excerpt = document.createElement('p');
      excerpt.className = 'theme-page-copy mt-3';
      excerpt.textContent = post.excerpt || 'No summary available.';

      article.append(title, meta, excerpt);
      return article;
    };

    const renderSearch = () => {
      if (!input || !status || !results) return;

      const params = new URLSearchParams(window.location.search);
      const query = (params.get('q') || '').trim();
      input.value = query;
      results.replaceChildren();

      if (!query) {
        status.textContent = 'Enter a search term to see matching posts.';
        return;
      }

      const tokens = query
        .toLowerCase()
        .normalize('NFKD')
        .replace(/[\u0300-\u036f]/g, '')
        .split(/\s+/)
        .filter(Boolean);

      const matches = searchIndex.filter((post) =>
        tokens.every((token) => post.searchText.includes(token)),
      );

      status.textContent =
        matches.length === 0
          ? `No results for "${query}".`
          : `${matches.length} result${matches.length === 1 ? '' : 's'} for "${query}".`;

      if (matches.length === 0) {
        return;
      }

      const fragment = document.createDocumentFragment();
      for (const post of matches) {
        fragment.appendChild(renderResult(post));
      }
      results.appendChild(fragment);
    };

    renderSearch();
  </script>
</Layout>
