---
import Layout from '../../../layouts/Layout.astro';
import PostCard from '../../../components/PostCard.astro';
import { loadPosts, postsByCategory, paginate, PAGE_SIZE } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = loadPosts();
  const cats = new Set();
  for (const p of posts) {
    const c = (p.frontmatter.category||'').toString().trim();
    if (c) cats.add(c);
  }
  return Array.from(cats).map(category => ({ params: { category } }));
}

const { category } = Astro.params;
const posts = loadPosts();
const filtered = postsByCategory(posts, category);
const { items, current, totalPages } = paginate(filtered, 1, PAGE_SIZE);
---

<Layout>
  <header class="mb-6">
    <h1 class="text-2xl font-semibold text-slate-900">Category: {category}</h1>
  </header>

  <section class="space-y-4">
    {items.map(p=> (
      <PostCard post={p} />
    ))}
  </section>

  <nav class="flex items-center justify-between mt-6 text-sm text-slate-600">
    {current>1 ? <a class="text-indigo-600 hover:underline" href={current===2?`/categories/${category}`:`/categories/${category}/page/1`}>← Newer</a> : <span />}
    {current<totalPages ? <a class="text-indigo-600 hover:underline" href={`/categories/${category}/page/${current+1}`}>Older →</a> : <span />}
  </nav>
</Layout>
