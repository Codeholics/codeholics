---
import Layout from '../../../../layouts/Layout.astro';
import PostCard from '../../../../components/PostCard.astro';
import { loadPosts, postsByCategory, paginate, PAGE_SIZE } from '../../../../lib/posts';

export async function getStaticPaths() {
  const posts = loadPosts();
  const map = new Map();
  for (const p of posts) {
    const c = (p.frontmatter.category||'').toString().trim();
    if (!c) continue;
    const arr = map.get(c) || [];
    arr.push(p);
    map.set(c, arr);
  }
  const paths = [];
  for (const [category, arr] of map.entries()) {
    const pages = Math.max(1, Math.ceil(arr.length / PAGE_SIZE));
    for (let i=1;i<=pages;i++) paths.push({ params: { category, page: String(i) } });
  }
  return paths;
}

const { category, page } = Astro.params;
const posts = loadPosts();
const filtered = postsByCategory(posts, category);
const { items, current, totalPages } = paginate(filtered, Number(page), PAGE_SIZE);
---

<Layout>
  <header class="mb-4">
    <h1 class="text-xl font-semibold text-slate-900">Category: {category} — Page {current}/{totalPages}</h1>
  </header>

  <section class="space-y-4">
    {items.map(p=> (
      <PostCard post={p} />
    ))}
  </section>

  <nav class="flex items-center justify-between mt-6 text-sm text-slate-600">
    {current>1 ? <a class="text-indigo-600 hover:underline" href={current===2?`/categories/${category}`:`/categories/${category}/page/1`}>← Newer</a> : <span />}
    {current<totalPages ? <a class="text-indigo-600 hover:underline" href={`/categories/${category}/page/${current+1}`}>Older →</a> : <span />}
  </nav>
</Layout>
