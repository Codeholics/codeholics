---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { loadPosts, paginate, PAGE_SIZE } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await loadPosts();
  const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
  const paths = [];
  for (let i = 1; i <= totalPages; i++) paths.push({ params: { page: String(i) } });
  return paths;
}

const { page } = Astro.params;
const posts = await loadPosts();
const { items, current, totalPages } = paginate(posts, Number(page), PAGE_SIZE);
---

<Layout>
  <header class="mb-6">
    <h1 class="theme-page-title text-2xl font-semibold">Posts — Page {current} of {totalPages}</h1>
  </header>

  <section class="space-y-4">
    {items.map(post => (
      <PostCard post={post} />
    ))}
  </section>

  <nav class="theme-page-copy flex items-center justify-between mt-6 text-sm">
    {current>1 ? <a class="theme-link hover:underline" href={current===2?'/':'/page/1'}>← Newer</a> : <span />}
    {current<totalPages ? <a class="theme-link hover:underline" href={`/page/${current+1}`}>Older →</a> : <span />}
  </nav>
</Layout>
