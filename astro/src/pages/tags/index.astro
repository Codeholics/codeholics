---
import Layout from '../../layouts/Layout.astro';

import PostCard from '../../components/PostCard.astro';
import { loadPosts, getAllTags } from '../../lib/posts';

const posts = loadPosts();
const tags = getAllTags(posts);
---

<Layout>
  <header class="mb-6">
    <h1 class="text-2xl font-semibold text-slate-900">Tags</h1>
  </header>

  <ul class="space-y-2">
    {tags.map(t=> (
      <li class="flex items-center justify-between py-2 border-b last:border-b-0"><a class="text-indigo-600 hover:underline" href={`/tags/${encodeURIComponent(t.tag)}`}>{t.tag}</a> <span class="text-sm text-slate-600">{t.count}</span></li>
    ))}
  </ul>
</Layout>
